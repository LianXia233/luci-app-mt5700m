#!/bin/sh

TAG='mt5700m-manager'
LOCK_DIR="${MT5700M_MANAGER_LOCK:-/var/lock/mt5700m-manager.lock}"
STATE_DIR="${MT5700M_MANAGER_STATE:-/var/run/mt5700m}"
LOG_FILE="${MT5700M_MANAGER_LOG:-/tmp/mt5700m-manager.log}"
USB_HELPER="${MT5700M_USB_HELPER:-/usr/share/mt5700m/usb.sh}"
AT_HELPER="${MT5700M_AT_HELPER:-/usr/sbin/mt5700m-at}"
TEMP_CACHE="${STATE_DIR}/temperature"
INTERFACE='MT5700M'
INTERFACE6='MT5700Mv6'

# --- health check / recovery policy ---------------------------------------
# Defaults only; every value is overridable through UCI (mt5700m.recovery.*).
HEALTH_MAX_RETRIES=3      # consecutive failed recovery rounds before halting
HEALTH_BACKOFF_BASE=60    # exponential backoff base, seconds
HEALTH_BACKOFF_MAX=900    # backoff ceiling, seconds
HEALTH_ROUND_TIMEOUT=90   # hard time budget for one recovery round, seconds
HEALTH_PROBE_TIMEOUT=5    # per-probe (ping / DNS) timeout, seconds
HEALTH_PING_HOST='223.5.5.5'
HEALTH_PING_HOST6='2400:3200::1'
HEALTH_DNS_HOST='www.baidu.com'
HEALTH_V6_COOLDOWN=300    # min. spacing between MT5700Mv6 recycles, seconds
HEALTH_HALT_NOTIFY=600    # reminder interval once recovery is halted, seconds
HEALTH_RADIO_SETTLE=45    # max wait for service after a radio cycle, seconds

# Recovery bookkeeping (tmpfs, cleared on reboot).
FAIL_COUNT_FILE="${STATE_DIR}/recovery_failures"
NEXT_ATTEMPT_FILE="${STATE_DIR}/recovery_next_attempt"
HALT_FILE="${STATE_DIR}/recovery_halted"
HALT_NOTICE_FILE="${STATE_DIR}/recovery_halt_notice"
TRANSIENT_FILE="${STATE_DIR}/transient_notified"
V6_RECOVER_FILE="${STATE_DIR}/v6_recover_at"

HEALTH_STATE='unknown'
HEALTH_DETAIL=''
DIAL_DETAIL='notrun'
DIAL_STAT4=''
DIAL_STAT6=''
DIAL_ERR4=''
DIAL_ERR6=''
HEALTH_ADDR4='-'
HEALTH_ADDR6='-'
HEALTH_DEVICE='-'
HEALTH_CARRIER=0
CONNECTIVITY_DETAIL='notrun'
ROUND_DEADLINE=0
RECOVERY_REASON=''

[ -r "${USB_HELPER}" ] && . "${USB_HELPER}"

# The log lives on tmpfs, i.e. in RAM.  A wedged link used to append on every
# poll with no upper bound, so cap the file and keep the most recent tail.
LOG_MAX_LINES="${MT5700M_LOG_MAX_LINES:-2000}"

log_rotate_if_needed() {
	local lines
	[ "${LOG_MAX_LINES}" -gt 0 ] || return 0
	lines="$(wc -l < "${LOG_FILE}" 2>/dev/null || echo 0)"
	case "${lines}" in ''|*[!0-9]*) return 0 ;; esac
	[ "${lines}" -gt "${LOG_MAX_LINES}" ] || return 0
	tail -n "${LOG_MAX_LINES}" "${LOG_FILE}" > "${LOG_FILE}.tmp" 2>/dev/null || return 0
	mv "${LOG_FILE}.tmp" "${LOG_FILE}" 2>/dev/null || true
}

log_message() {
	local message="$*"
	mkdir -p "${STATE_DIR}"
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${message}" >> "${LOG_FILE}"
	log_rotate_if_needed
	logger -t "${TAG}" -- "${message}"
}

acquire_lock() {
	local owner current
	if mkdir "${LOCK_DIR}" 2>/dev/null; then
		echo "$$" > "${LOCK_DIR}/pid"
		return 0
	fi
	owner="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
	case "${owner}" in ''|*[!0-9]*) owner='' ;; esac
	if [ -n "${owner}" ] && ! kill -0 "${owner}" 2>/dev/null; then
		# The recorded owner is dead.  Re-read once more: a concurrent
		# reclaim may already have swapped in a live pid, and deleting the
		# directory in that window would let a third process slip in.
		current="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
		case "${current}" in ''|*[!0-9]*) current='' ;; esac
		[ -n "${current}" ] && [ "${current}" != "${owner}" ] && return 1
		rm -rf "${LOCK_DIR}" 2>/dev/null
		mkdir "${LOCK_DIR}" 2>/dev/null || return 1
		echo "$$" > "${LOCK_DIR}/pid"
		return 0
	fi
	# owner empty (the directory is mid-initialisation by another process) or a
	# live owner holds it: contesting here would either corrupt a fresh lock or
	# race a live holder, so back off and let the caller retry.
	return 1
}

acquire_lock_wait() {
	local attempts=0
	while ! acquire_lock; do
		attempts=$((attempts + 1))
		[ "${attempts}" -lt 8 ] || return 1
		sleep 1
	done
}

release_lock() {
	# Only release a lock this process actually owns.  A stale-pid sweep can
	# let another instance claim the directory, and deleting it here would
	# silently open the critical section to a third process.
	local owner
	[ -d "${LOCK_DIR}" ] || return 0
	owner="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
	case "${owner}" in ''|*[!0-9]*) owner='' ;; esac
	if [ -n "${owner}" ] && [ "${owner}" != "$$" ]; then
		return 0
	fi
	rm -rf "${LOCK_DIR}" 2>/dev/null || true
}

bool_value() {
	case "$1" in 1|true) echo 1 ;; *) echo 0 ;; esac
}

config_value() {
	uci -q get "mt5700m.connection.$1" 2>/dev/null || printf '%s\n' "$2"
}

recovery_value() {
	uci -q get "mt5700m.recovery.$1" 2>/dev/null || printf '%s\n' "$2"
}

# Accept only plain integers so a malformed UCI option cannot turn the
# recovery guard off (or make it wait forever).
numeric_value() {
	local value="$1" default="$2"
	case "${value}" in ''|*[!0-9]*) value="${default}" ;; esac
	printf '%s\n' "${value}"
}

state_read() {
	local value
	value="$(cat "$1" 2>/dev/null || true)"
	# Explicit whitespace chars, not '[:space:]': busybox tr treats the
	# class as a literal set of characters and strips nothing useful
	# (verified on device: '12 34' survives tr -d '[:space:]' unchanged).
	value="$(printf '%s' "${value}" | tr -d ' \t\r\n')"
	case "${value}" in ''|*[!0-9]*) value="$2" ;; esac
	printf '%s\n' "${value}"
}

state_write() {
	mkdir -p "${STATE_DIR}" 2>/dev/null || true
	printf '%s\n' "$2" > "$1" 2>/dev/null || true
}

state_clear() {
	rm -f "$1" 2>/dev/null || true
}

load_health_config() {
	HEALTH_MAX_RETRIES="$(numeric_value "$(recovery_value max_retries 3)" 3)"
	HEALTH_BACKOFF_BASE="$(numeric_value "$(recovery_value backoff_base 60)" 60)"
	HEALTH_BACKOFF_MAX="$(numeric_value "$(recovery_value backoff_max 900)" 900)"
	HEALTH_ROUND_TIMEOUT="$(numeric_value "$(recovery_value round_timeout 90)" 90)"
	HEALTH_PROBE_TIMEOUT="$(numeric_value "$(recovery_value probe_timeout 5)" 5)"
	HEALTH_V6_COOLDOWN="$(numeric_value "$(recovery_value v6_cooldown 300)" 300)"
	HEALTH_RADIO_SETTLE="$(numeric_value "$(recovery_value radio_settle 45)" 45)"
	HEALTH_HALT_NOTIFY="$(numeric_value "$(recovery_value halt_notify 600)" 600)"
	HEALTH_PING_HOST="$(recovery_value ping_host '223.5.5.5')"
	HEALTH_PING_HOST6="$(recovery_value ping_host6 '2400:3200::1')"
	HEALTH_DNS_HOST="$(recovery_value dns_host 'www.baidu.com')"
	[ "${HEALTH_MAX_RETRIES}" -ge 1 ] || HEALTH_MAX_RETRIES=1
	[ "${HEALTH_ROUND_TIMEOUT}" -ge 30 ] || HEALTH_ROUND_TIMEOUT=30
	[ "${HEALTH_PROBE_TIMEOUT}" -ge 2 ] || HEALTH_PROBE_TIMEOUT=2
	[ "${HEALTH_BACKOFF_MAX}" -ge "${HEALTH_BACKOFF_BASE}" ] || HEALTH_BACKOFF_MAX="${HEALTH_BACKOFF_BASE}"
	[ "${HEALTH_RADIO_SETTLE}" -ge 5 ] || HEALTH_RADIO_SETTLE=5
}

# Run a command under a wall-clock limit when coreutils-timeout is available.
run_with_timeout() {
	local limit="$1"
	shift
	if command -v timeout >/dev/null 2>&1; then
		timeout "${limit}" "$@"
	else
		"$@"
	fi
}

run_temperature_query() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 5 "${AT_HELPER}" temperature
	else
		"${AT_HELPER}" temperature
	fi
}

refresh_temperature_cache() {
	local output value tmp

	[ -x "${AT_HELPER}" ] || return 1
	output="$(run_temperature_query 2>/dev/null || true)"
	value="$(printf '%s\n' "${output}" | sed -n 's/^temperature=//p' | head -n 1)"
	awk -v value="${value}" 'BEGIN {
		if (value !~ /^-?[0-9]+([.][0-9]+)?$/ || value < -40 || value > 150)
			exit 1
	}' || return 1

	mkdir -p "${STATE_DIR}" || return 1
	tmp="${TEMP_CACHE}.$$"
	{
		printf '%s\n' "${output}" | grep -E '^(temp_[a-z0-9_]+|temperature)=-?[0-9]+([.][0-9]+)?$|^temperature_sensor=[a-z0-9_]+$' || true
		printf 'updated=%s\n' "$(date +%s)"
	} > "${tmp}" || return 1
	mv "${tmp}" "${TEMP_CACHE}" || return 1
	chmod 0644 "${TEMP_CACHE}" 2>/dev/null || true
}

set_if_changed() {
	local key="$1" value="$2" current
	current="$(uci -q get "${key}" 2>/dev/null || true)"
	[ "${current}" = "${value}" ] && return 0
	uci -q set "${key}=${value}" || return 1
	CONFIG_CHANGED=1
}

delete_if_present() {
	local key="$1"
	uci -q get "${key}" >/dev/null 2>&1 || return 0
	uci -q delete "${key}" || return 1
	CONFIG_CHANGED=1
}

list_contains() {
	local key="$1" wanted="$2" value
	for value in $(uci -q get "${key}" 2>/dev/null); do
		[ "${value}" = "${wanted}" ] && return 0
	done
	return 1
}

ensure_firewall_network() {
	local network="$1" zone
	zone="$(uci -q show firewall 2>/dev/null | sed -n "s/^\(firewall\.[^.]*\)\.name='wan'$/\1/p" | head -n 1)"
	[ -n "${zone}" ] || return 0
	list_contains "${zone}.network" "${network}" && return 0
	uci -q add_list "${zone}.network=${network}" || return 1
	FIREWALL_CHANGED=1
}

effective_policy() {
	local mode owner configured_metric
	mode="$(uci -q get h5000m_netmode.settings.mode 2>/dev/null || true)"
	owner="$(uci -q get h5000m_netmode.settings.ipv6_owner 2>/dev/null || true)"
	configured_metric="$(config_value metric 50)"
	case "${configured_metric}" in ''|*[!0-9]*) configured_metric=50 ;; esac

	case "${mode}" in
		modem_first|modem_only) EFFECTIVE_METRIC=10 ;;
		wan_first|wan_only) EFFECTIVE_METRIC=50 ;;
		*) EFFECTIVE_METRIC="${configured_metric}" ;;
	esac
	case "${mode}" in wan_only) IPV4_DEFAULT=0 ;; *) IPV4_DEFAULT=1 ;; esac
	case "${owner}" in
		modem) IPV6_DEFAULT=1; IPV6_AUTO=1 ;;
		wan) IPV6_DEFAULT=0; IPV6_AUTO=0 ;;
		*)
			case "${mode}" in modem_first|modem_only) IPV6_DEFAULT=1; IPV6_AUTO=1 ;; *) IPV6_DEFAULT=0; IPV6_AUTO=0 ;; esac
			;;
	esac
}

ensure_network() {
	local netdev="$1" pdp_type dns current_dns
	CONFIG_CHANGED=0
	FIREWALL_CHANGED=0
	pdp_type="$(config_value pdp_type ipv4v6)"
	case "${pdp_type}" in ip|ipv6|ipv4v6) ;; *) pdp_type='ipv4v6' ;; esac
	effective_policy

	set_if_changed "network.${INTERFACE}" 'interface'
	set_if_changed "network.${INTERFACE}.managed_by" 'mt5700m'
	set_if_changed "network.${INTERFACE}.device" "${netdev}"
	set_if_changed "network.${INTERFACE}.ifname" "${netdev}"
	set_if_changed "network.${INTERFACE}.metric" "${EFFECTIVE_METRIC}"
	set_if_changed "network.${INTERFACE}.defaultroute" "${IPV4_DEFAULT}"
	set_if_changed "network.${INTERFACE}.norelease" '1'
	delete_if_present "network.${INTERFACE}.modem_config"
	if [ "${pdp_type}" = 'ipv6' ]; then
		set_if_changed "network.${INTERFACE}.proto" 'none'
	else
		set_if_changed "network.${INTERFACE}.proto" 'dhcp'
	fi
	dns="$(uci -q get mt5700m.connection.dns_list 2>/dev/null || true)"
	current_dns="$(uci -q get network.${INTERFACE}.dns 2>/dev/null || true)"
	if [ -n "${dns}" ]; then
		set_if_changed "network.${INTERFACE}.peerdns" '0'
		if [ "${current_dns}" != "${dns}" ]; then
			delete_if_present "network.${INTERFACE}.dns"
			for dns in ${dns}; do uci -q add_list "network.${INTERFACE}.dns=${dns}"; done
			CONFIG_CHANGED=1
		fi
	else
		delete_if_present "network.${INTERFACE}.dns"
		delete_if_present "network.${INTERFACE}.peerdns"
	fi

	if [ "${pdp_type}" = 'ip' ]; then
		delete_if_present "network.${INTERFACE6}"
	else
		set_if_changed "network.${INTERFACE6}" 'interface'
		set_if_changed "network.${INTERFACE6}.managed_by" 'mt5700m'
		set_if_changed "network.${INTERFACE6}.proto" 'dhcpv6'
		set_if_changed "network.${INTERFACE6}.device" "@${INTERFACE}"
		set_if_changed "network.${INTERFACE6}.ifname" "@${INTERFACE}"
		set_if_changed "network.${INTERFACE6}.metric" "${EFFECTIVE_METRIC}"
		set_if_changed "network.${INTERFACE6}.defaultroute" "${IPV6_DEFAULT}"
		set_if_changed "network.${INTERFACE6}.auto" "${IPV6_AUTO}"
		set_if_changed "network.${INTERFACE6}.extendprefix" '1'
		delete_if_present "network.${INTERFACE6}.modem_config"
	fi
	ensure_firewall_network "${INTERFACE}"
	[ "${pdp_type}" = 'ip' ] || ensure_firewall_network "${INTERFACE6}"

	if [ "${CONFIG_CHANGED}" = '1' ]; then
		uci -q commit network
		/etc/init.d/network reload >/dev/null 2>&1 || true
		log_message "network synchronized device=${netdev} protocol=${pdp_type} metric=${EFFECTIVE_METRIC}"
	fi
	if [ "${FIREWALL_CHANGED}" = '1' ]; then
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi
}

interface_up() {
	local name="$1" output
	output="$(ubus call "network.interface.${name}" status 2>/dev/null || true)"
	[ "$(printf '%s' "${output}" | jsonfilter -e '@.up' 2>/dev/null)" = 'true' ]
}

# ---- address discovery ----------------------------------------------------
# "up" alone is not enough: on DHCP the protocol may still be running without
# a lease, which shows up in LuCI as "interface exists but no IP".
#
# netifd publishes addresses inside JSON arrays.  The dotted jsonfilter syntax
# ("@.ipv4-address[0].address") is rejected by current jsonfilter builds with
# "Syntax error: Invalid escape sequence", which made every address lookup
# return nothing: the manager concluded "no IP" on a perfectly working link
# and restarted the data path every single cycle.  Use the bracket-quoted
# form, and fall back to `ip` so that a jsonfilter change can never again be
# mistaken for a missing address.
ubus_status() {
	ubus call "network.interface.$1" status 2>/dev/null || true
}

iface_field() { # $1=interface $2=scalar key
	ubus_status "$1" | jsonfilter -e "@.$2" 2>/dev/null | head -n 1
}

iface_device() { # $1=interface; prints the l3 device, empty when unknown
	local dev
	dev="$(iface_field "$1" l3_device)"
	[ -n "${dev}" ] || dev="$(iface_field "$1" device)"
	case "${dev}" in @*) dev='' ;; esac
	printf '%s\n' "${dev}"
}

iface_array_expr() { # $1=interface $2=array key $3=suffix expression
	ubus_status "$1" | jsonfilter -e "@['$2']$3" 2>/dev/null | head -n 1
}

iface_address() { # $1=interface $2=4|6
	local address dev
	address="$(iface_array_expr "$1" "ipv$2-address" "[0]['address']")"
	if [ -n "${address}" ]; then
		printf '%s\n' "${address}"
		return 0
	fi
	dev="$(iface_device "$1")"
	[ -n "${dev}" ] || return 1
	address="$(ip -o "-$2" addr show dev "${dev}" scope global 2>/dev/null | awk '{print $4}' | sed 's#/.*##' | head -n 1)"
	[ -n "${address}" ] || return 1
	printf '%s\n' "${address}"
}

iface_dns_server() { # $1=interface; first DNS server handed out by the modem
	local dns
	dns="$(iface_array_expr "$1" dns-server "[0]")"
	if [ -n "${dns}" ]; then
		printf '%s\n' "${dns}"
		return 0
	fi
	ubus_status "$1" | tr -d '\n' | sed -n 's/.*"dns-server":[^[]*\[[^"]*"\([0-9a-fA-F.:]*\)".*/\1/p'
}

interface_has_ip() {
	iface_address "${INTERFACE}" 4 >/dev/null
}

interface6_has_ip() {
	iface_address "${INTERFACE6}" 6 >/dev/null
}

# ---- connectivity probe ---------------------------------------------------
# Only reached when neither stack reports an address.  A modem data path can be
# perfectly usable while netifd has not published the address yet (DHCP renew,
# slow DHCPv6, RA-only setups).  Probing before tearing the link down is what
# stops the "no IP -> rebuild -> no IP" treadmill.
probe_ping() { # $1=family $2=device (may be empty) $3=target
	local limit="$((HEALTH_PROBE_TIMEOUT * 2 + 2))"
	if [ -n "$2" ]; then
		# Always bind the probe to the modem device.  An unbound probe can be
		# answered by a local proxy/tun interface (sing-box style setups reply
		# to everything) or by a second WAN, which would report a dead
		# cellular link as healthy.
		run_with_timeout "${limit}" ping -"$1" -c 2 -W "${HEALTH_PROBE_TIMEOUT}" -I "$2" "$3" >/dev/null 2>&1
		return $?
	fi
	# No device known: best effort through the default route.
	run_with_timeout "${limit}" ping -"$1" -c 2 -W "${HEALTH_PROBE_TIMEOUT}" "$3" >/dev/null 2>&1
}

probe_dns() { # $1=dns server handed out by the modem
	run_with_timeout "$((HEALTH_PROBE_TIMEOUT * 2 + 2))" \
		nslookup "${HEALTH_DNS_HOST}" "$1" >/dev/null 2>&1
}

connectivity_probe() { # $1=device; 0 = the data path really carries traffic
	local dev="$1" dns started budget probe_cost
	dns="$(iface_dns_server "${INTERFACE}")"
	[ -n "${dns}" ] || dns="$(iface_dns_server "${INTERFACE6}")"
	# Total probe budget: a black-holed link must not inflate the recovery
	# round by waiting on every probe in turn.
	started="$(date +%s)"
	budget=$((HEALTH_PROBE_TIMEOUT * 4))
	# Worst-case wall clock of one probe, used to keep the whole sequence
	# inside the budget rather than only checking it after the fact.
	probe_cost=$((HEALTH_PROBE_TIMEOUT * 2 + 2))
	if probe_ping 4 "${dev}" "${HEALTH_PING_HOST}"; then
		CONNECTIVITY_DETAIL="ping4=ok ping6=skip dns=skip"
		return 0
	fi
	probe_budget_left "${started}" "${budget}" "${probe_cost}" || {
		CONNECTIVITY_DETAIL="ping4=fail ping6=skip dns=skip(probe-budget)"
		return 1
	}
	if probe_ping 6 "${dev}" "${HEALTH_PING_HOST6}"; then
		CONNECTIVITY_DETAIL="ping4=fail ping6=ok dns=skip"
		return 0
	fi
	if [ -z "${dns}" ]; then
		# No modem DNS: the system resolver may belong to a proxy or another
		# WAN, so it is not evidence for this link.
		CONNECTIVITY_DETAIL="ping4=fail ping6=fail dns=skip(no-modem-dns)"
		return 1
	fi
	probe_budget_left "${started}" "${budget}" "${probe_cost}" || {
		CONNECTIVITY_DETAIL="ping4=fail ping6=fail dns=skip(probe-budget)"
		return 1
	}
	if probe_dns "${dns}"; then
		CONNECTIVITY_DETAIL="ping4=fail ping6=fail dns=ok(server=${dns})"
		return 0
	fi
	CONNECTIVITY_DETAIL="ping4=fail ping6=fail dns=fail(server=${dns})"
	return 1
}

# $1=start epoch $2=budget seconds $3=cost the next probe may incur.
# Checking only "elapsed < budget" let a single probe overrun the whole
# budget, because one probe can itself take HEALTH_PROBE_TIMEOUT*2+2 seconds.
probe_budget_left() {
	[ "$(($(date +%s) - $1 + $3))" -le "$2" ]
}

# ---- layered health decision ----------------------------------------------
#   1. does netifd know the interface at all?
#   2. did the data path obtain an IPv4 or an IPv6 address?
#   3. no address on either stack -> run a real connectivity test (ICMP + DNS)
#      before declaring the link broken.
# Sets HEALTH_STATE (healthy|transient|unhealthy) plus HEALTH_DETAIL, and
# returns 0 when the link must be left alone.
# Read the link-layer carrier for a netdev.  Wrapped in a function (rather
# than an inline cat) so the health tests can drive carrier through a stub
# instead of depending on the real link state of whatever host runs them.
# Returns 0 when the interface reports carrier, 1 otherwise.
iface_carrier() { # $1=netdev
	local dev="$1" v
	[ -n "${dev}" ] || return 1
	v="$(cat "/sys/class/net/${dev}/carrier" 2>/dev/null || echo 0)"
	[ "${v}" = '1' ]
}

evaluate_health() {
	local addr4 addr6 dev
	HEALTH_ADDR4='none'
	HEALTH_ADDR6='none'
	HEALTH_DEVICE='none'
	HEALTH_CARRIER=0
	CONNECTIVITY_DETAIL='notrun'
	addr4="$(iface_address "${INTERFACE}" 4 || true)"
	addr6="$(iface_address "${INTERFACE6}" 6 || true)"
	dev="$(iface_device "${INTERFACE}" || true)"
	[ -n "${addr4}" ] && HEALTH_ADDR4="${addr4}"
	[ -n "${addr6}" ] && HEALTH_ADDR6="${addr6}"
	if [ -z "${dev}" ]; then
		dev="$(iface_device "${INTERFACE6}" || true)"
		[ -n "${dev}" ] && HEALTH_DEVICE="${dev}"
	else
		HEALTH_DEVICE="${dev}"
	fi
	if iface_carrier "${dev}"; then
		HEALTH_CARRIER=1
	fi

	# 1) interface known to netifd?
	if ! ubus call "network.interface.${INTERFACE}" status >/dev/null 2>&1 &&
		! ubus call "network.interface.${INTERFACE6}" status >/dev/null 2>&1; then
		HEALTH_STATE='unhealthy'
		HEALTH_DETAIL="iface=${INTERFACE}/${INTERFACE6} absent in netifd device=${HEALTH_DEVICE} carrier=${HEALTH_CARRIER}"
		return 1
	fi

	# 2) any address at all -> the data path is up, no probe needed.
	if [ -n "${addr4}" ] || [ -n "${addr6}" ]; then
		HEALTH_STATE='healthy'
		HEALTH_DETAIL="iface=${INTERFACE} device=${HEALTH_DEVICE} ipv4=${HEALTH_ADDR4} ipv6=${HEALTH_ADDR6} carrier=${HEALTH_CARRIER}"
		return 0
	fi

	# 3) addressless.  Ask the module first: an ICMP probe can never succeed in
	#    this state, so it can only ever confirm "broken" - it cannot show the
	#    link as still usable.  The module's own PDP state can.  Fall back to
	#    the probe only when the module is unreachable altogether.
	HEALTH_DETAIL="iface=${INTERFACE} device=${HEALTH_DEVICE} ipv4=none ipv6=none carrier=${HEALTH_CARRIER}"
	# The module's dial state only proves the radio side.  With carrier down
	# the host-side NCM link itself is broken (verified on device: module
	# reports v4=1/v6=1 while eth2 is DOWN and traffic cannot leave), so the
	# link must be rebuilt regardless of what the modem believes.
	if [ "${HEALTH_CARRIER}" = '1' ] && modem_dial_status; then
		HEALTH_STATE='transient'
		HEALTH_DETAIL="${HEALTH_DETAIL} dial=${DIAL_DETAIL}"
		return 0
	fi
	if [ "${DIAL_DETAIL}" = 'ndisstatqry=unavailable' ] && connectivity_probe "${dev}"; then
		HEALTH_STATE='transient'
		HEALTH_DETAIL="${HEALTH_DETAIL} dial=${DIAL_DETAIL} probe=${CONNECTIVITY_DETAIL}"
		return 0
	fi
	HEALTH_STATE='unhealthy'
	HEALTH_DETAIL="${HEALTH_DETAIL} dial=${DIAL_DETAIL} probe=${CONNECTIVITY_DETAIL}"
	return 1
}

# Address-based health without running any probe, for status reporting.
health_state_quick() {
	if [ -n "$(iface_address "${INTERFACE}" 4 || true)" ] ||
		[ -n "$(iface_address "${INTERFACE6}" 6 || true)" ]; then
		printf '%s\n' 'healthy'
	else
		printf '%s\n' 'no-address'
	fi
}

# A short-lived state anomaly (no address yet, but traffic still flows) is not
# a fault: warn once per interval, reset the retry counter and leave the link
# alone instead of cycling the modem.
health_note_transient() {
	local now last
	now="$(date +%s)"
	last="$(state_read "${TRANSIENT_FILE}" 0)"
	[ "${now}" -lt "${last}" ] && return 0
	log_message "transient state anomaly: ${HEALTH_DETAIL} - connectivity still works, keeping the link up (retry counter reset)"
	state_write "${TRANSIENT_FILE}" "$((now + HEALTH_HALT_NOTIFY))"
}

# The v4 link can be healthy while MT5700Mv6 (DHCPv6) still has no global
# address; recycle only the v6 interface so we do not drop the v4 path.
recover_interface6() { # $1=max seconds to spend (defaults to the round budget)
	local pdp_type attempt=0 now last limit started
	pdp_type="$(config_value pdp_type ipv4v6)"
	[ "${pdp_type}" = 'ip' ] && return 0
	[ "$(uci -q get network.${INTERFACE6}.auto 2>/dev/null || echo 1)" = '0' ] && return 0
	interface6_has_ip && return 0
	# Rate limit: DHCPv6/RA can legitimately need minutes, and this used to be
	# retried on every monitor tick, which hammered the v6 interface.
	now="$(date +%s)"
	last="$(state_read "${V6_RECOVER_FILE}" 0)"
	if [ "${now}" -lt "${last}" ]; then
		return 1
	fi
	state_write "${V6_RECOVER_FILE}" "$((now + HEALTH_V6_COOLDOWN))"
	log_message "interface ${INTERFACE6} has no IPv6 address, recycling (next attempt not before ${HEALTH_V6_COOLDOWN}s)"
	# Bound the recycling: five rounds of ifdown/ifup plus their sleeps can
	# run for minutes, and this used to sit entirely outside the round budget.
	limit="${1:-0}"
	if [ "${limit}" -le 0 ]; then
		limit=$((ROUND_DEADLINE - $(date +%s)))
		[ "${limit}" -gt 0 ] || limit=30
	fi
	started="$(date +%s)"
	while [ "${attempt}" -lt 5 ]; do
		if [ "$(($(date +%s) - started))" -ge "${limit}" ]; then
			log_message "interface ${INTERFACE6} recycling stopped after ${limit}s budget"
			return 1
		fi
		ifdown "${INTERFACE6}" >/dev/null 2>&1 || true
		sleep 2
		ifup "${INTERFACE6}" >/dev/null 2>&1 || true
		if interface6_has_ip; then
			log_message "interface ${INTERFACE6} got IPv6 after ${attempt} recycle"
			return 0
		fi
		attempt=$((attempt + 1))
	done
	log_message "interface ${INTERFACE6} still has no IPv6 address"
	return 1
}

bring_up() {
	local pdp_type
	pdp_type="$(config_value pdp_type ipv4v6)"
	ifup "${INTERFACE}" >/dev/null 2>&1 || true
	case "${pdp_type}" in
		ip) ifdown "${INTERFACE6}" >/dev/null 2>&1 || true ;;
		*)
			if [ "$(uci -q get network.${INTERFACE6}.auto 2>/dev/null || echo 1)" = '0' ]; then
				ifdown "${INTERFACE6}" >/dev/null 2>&1 || true
			else
				ifup "${INTERFACE6}" >/dev/null 2>&1 || true
			fi
			;;
	esac
}

bring_down() {
	ifdown "${INTERFACE6}" >/dev/null 2>&1 || true
	ifdown "${INTERFACE}" >/dev/null 2>&1 || true
}

# Is the module itself reachable and service-registered?  On NCM/ECM setups
# the modem can be online with an active data link while the host interface is
# missing or not up yet; this tells sync_manager whether to wait/recover the
# host side or to kick the module side.
modem_connected() {
	local srv
	srv="$("${AT_HELPER}" command 'AT^SYSINFOEX' 2>/dev/null | sed -n 's/^\^SYSINFOEX:[[:space:]]*//p' | head -n 1)"
	case "${srv}" in 2,*) return 0 ;; *) return 1 ;; esac
}

# Ask the module about its own dial state (AT^NDISSTATQRY=<cid>, manual 16.4).
#
# This is the only usable evidence while the host interface has no address.
# An ICMP probe cannot answer the question in that situation: without a source
# address the kernel has nothing to send from, and `ping -I <dev>` on an
# addressless interface fails for both families (verified on device).  The
# module, however, knows whether the PDP context is up and reports a 3GPP
# cause code when it is not - which also turns an opaque failure into a
# diagnosable one.
# Sets DIAL_DETAIL / DIAL_STAT4 / DIAL_STAT6 / DIAL_ERR4 / DIAL_ERR6.
modem_dial_status() {
	local raw
	DIAL_DETAIL='ndisstatqry=unavailable'
	DIAL_STAT4=''
	DIAL_STAT6=''
	DIAL_ERR4=''
	DIAL_ERR6=''
	raw="$("${AT_HELPER}" command 'AT^NDISSTATQRY=1' 2>/dev/null |
		tr -d '\r' |
		sed -n 's/^\^NDISSTATQRY:[[:space:]]*//p' | head -n 1)"
	[ -n "${raw}" ] || return 1
	# ^NDISSTATQRY: <ipv4_stat>,<ipv4_err>,,"IPV4",<ipv6_stat>,<ipv6_err>,,"IPV6"
	IFS=, read -r DIAL_STAT4 DIAL_ERR4 _ _ DIAL_STAT6 DIAL_ERR6 _ _ <<EOF
${raw}
EOF
	DIAL_DETAIL="ndisstatqry=v4=${DIAL_STAT4:-?}/v6=${DIAL_STAT6:-?}"
	[ -n "${DIAL_ERR4}" ] && DIAL_DETAIL="${DIAL_DETAIL} err4=${DIAL_ERR4}"
	[ -n "${DIAL_ERR6}" ] && DIAL_DETAIL="${DIAL_DETAIL} err6=${DIAL_ERR6}"
	# <stat>: 0 disconnected, 1 connected, 2 connecting, 3 disconnecting
	[ "${DIAL_STAT4}" = '1' ] && return 0
	[ "${DIAL_STAT6}" = '1' ] && return 0
	return 1
}

# Query the module USB port mode.  4 = NCM (CDC-NCM, recommended for Linux),
# 0 = ECM; other values may leave the USB data interface absent.
modem_usb_mode() {
	local mode
	mode="$("${AT_HELPER}" command 'AT^SETMODE?' 2>/dev/null | tr -d '\r' | grep -oE '^[0-9]+$' | head -n 1)"
	case "${mode}" in ''|*[!0-9]*) return 1 ;; esac
	printf '%s\n' "${mode}"
}

# Ensure the module stays in NCM mode (SETMODE=4).  A wrong mode (e.g. 2) is
# a root cause of "modem online but OpenWrt has no network interface": the USB
# NCM device simply never enumerates.  The change only takes effect after a
# module reboot, so we write it at most once per 10 minutes and log the
# pending reboot requirement instead of hammering the modem every cycle.
modem_ensure_usb_mode() {
	local mode fixed_at now
	mode="$(modem_usb_mode)" || return 1
	[ "${mode}" = '4' ] && {
		rm -f "${STATE_DIR}/usb_mode_fix_time" 2>/dev/null || true
		return 0
	}
	log_message "usb mode=${mode} not NCM(4); applying AT^SETMODE=4 (takes effect after module reboot)"
	fixed_at="$(cat "${STATE_DIR}/usb_mode_fix_time" 2>/dev/null || echo 0)"
	case "${fixed_at}" in ''|*[!0-9]*) fixed_at=0 ;; esac
	now="$(date +%s)"
	[ "${now}" -ge "$((fixed_at + 600))" ] || return 1
	"${AT_HELPER}" command 'AT^SETMODE=4' >/dev/null 2>&1 || true
	echo "${now}" > "${STATE_DIR}/usb_mode_fix_time" 2>/dev/null || true
	return 1
}

# Rebuild the module-side data link without dropping network registration.
# Prefer NDISDUP (tear down + re-establish PDP); fall back to a radio cycle
# if carrier still does not appear on $1.
# Every step is time-boxed: a wedged AT channel must not stall the recovery
# round (and with it the monitor) indefinitely.
modem_cycle_link() {
	local netdev="$1" attempt=0

	run_with_timeout 10 "${AT_HELPER}" command 'AT^NDISDUP=1,0' >/dev/null 2>&1 || true
	sleep 2
	run_with_timeout 10 "${AT_HELPER}" command 'AT^NDISDUP=1,1' >/dev/null 2>&1 || true
	while [ "${attempt}" -lt 5 ]; do
		if iface_carrier "${netdev}"; then
			return 0
		fi
		sleep 2
		attempt=$((attempt + 1))
	done
	log_message 'NDIS rebuild did not restore carrier, cycling radio'
	run_with_timeout 10 "${AT_HELPER}" command 'AT+CFUN=0' >/dev/null 2>&1 || true
	# Manual 6.1.2: the gap between CFUN=0 and CFUN=1 must exceed 1 s.
	sleep 2
	run_with_timeout 10 "${AT_HELPER}" command 'AT+CFUN=1' >/dev/null 2>&1 || true
	modem_wait_service "${HEALTH_RADIO_SETTLE}" || true
}

# AT+CFUN=1 returns OK as soon as the command is accepted, not when the module
# is usable again.  Searching for and registering on a 5G network afterwards
# takes anywhere from a few seconds to well over half a minute.  Bringing the
# interface up while the module is still camping gets no DHCP answer, which
# used to be counted as a failed recovery round and pushed the link towards
# the retry ceiling.
modem_wait_service() { # $1=timeout seconds
	local limit="${1:-45}" waited=0
	sleep 3
	while [ "${waited}" -lt "${limit}" ]; do
		modem_connected && return 0
		sleep 2
		waited=$((waited + 2))
	done
	log_message "module reports no service ${limit}s after the radio cycle"
	return 1
}

# ---- recovery rate limiting ----------------------------------------------
# Without these guards a permanently broken data path made the monitor restart
# the modem every ~90s forever.  The policy now is: at most HEALTH_MAX_RETRIES
# consecutive rounds, exponential backoff between them, a hard time budget per
# round, and a full stop (with a loud error) once the ceiling is hit.
recovery_failures() {
	state_read "${FAIL_COUNT_FILE}" 0
}

# Called when the link is working again: drop the retry counter, the pending
# backoff and the halted flag.  Transient/halt notice timestamps are kept so
# their rate limiting survives the 15s poll that follows a healthy check.
recovery_clear_failures() {
	local failures
	failures="$(recovery_failures)"
	[ "${failures}" = '0' ] && [ ! -f "${HALT_FILE}" ] && return 0
	state_write "${FAIL_COUNT_FILE}" 0
	state_clear "${NEXT_ATTEMPT_FILE}"
	state_clear "${HALT_FILE}"
	state_clear "${HALT_NOTICE_FILE}"
}

# Full reset, used by user-initiated actions (connect / redial / manual reset).
recovery_reset() {
	recovery_clear_failures
	state_clear "${TRANSIENT_FILE}"
}

# One-line diagnostic for the current round: interface, address state,
# connectivity result, retry counter and the action that follows.
log_recovery() { # $1=stage $2=next action
	log_message "recovery[${1}] state=${HEALTH_STATE} ${HEALTH_DETAIL} retries=$(recovery_failures)/${HEALTH_MAX_RETRIES} next=${2}"
}

recovery_halt_notice() {
	local now last failures="$1"
	now="$(date +%s)"
	last="$(state_read "${HALT_NOTICE_FILE}" 0)"
	[ "${now}" -lt "${last}" ] && return 0
	log_message "ERROR: recovery halted after ${failures}/${HEALTH_MAX_RETRIES} consecutive failed rounds; ${HEALTH_DETAIL}"
	log_message "ERROR: automatic link rebuild is suspended until manual intervention. Check module registration/APN/signal, then run 'mt5700m-manager redial' or 'mt5700m-manager reset-recovery' (or remove ${HALT_FILE})"
	state_write "${HALT_NOTICE_FILE}" "$((now + HEALTH_HALT_NOTIFY))"
}

# Record a failed round and schedule the next one, or halt.
recovery_record_failure() {
	local failures exponent backoff now
	failures="$(recovery_failures)"
	failures=$((failures + 1))
	now="$(date +%s)"
	state_write "${FAIL_COUNT_FILE}" "${failures}"
	if [ "${failures}" -ge "${HEALTH_MAX_RETRIES}" ]; then
		state_write "${HALT_FILE}" "${now}"
		state_clear "${NEXT_ATTEMPT_FILE}"
		recovery_halt_notice "${failures}"
		return 0
	fi
	backoff="${HEALTH_BACKOFF_BASE}"
	exponent=$((failures - 1))
	while [ "${exponent}" -gt 0 ]; do
		backoff=$((backoff * 2))
		exponent=$((exponent - 1))
	done
	[ "${backoff}" -le "${HEALTH_BACKOFF_MAX}" ] || backoff="${HEALTH_BACKOFF_MAX}"
	state_write "${NEXT_ATTEMPT_FILE}" "$((now + backoff))"
	log_message "recovery round ${failures}/${HEALTH_MAX_RETRIES} failed; backing off ${backoff}s before the next attempt"
}

# Returns 0 when a new recovery round may start; sets RECOVERY_REASON when not.
recovery_gate() {
	local failures next now
	RECOVERY_REASON=''
	failures="$(recovery_failures)"
	next="$(state_read "${NEXT_ATTEMPT_FILE}" 0)"
	now="$(date +%s)"
	if [ -f "${HALT_FILE}" ]; then
		RECOVERY_REASON="halted after ${failures}/${HEALTH_MAX_RETRIES} failed rounds, manual intervention required"
		recovery_halt_notice "${failures}"
		return 1
	fi
	if [ "${now}" -lt "${next}" ]; then
		RECOVERY_REASON="in backoff, next attempt in $((next - now))s (retries=${failures}/${HEALTH_MAX_RETRIES})"
		return 1
	fi
	return 0
}

# Shared handling for "the link works - leave it alone".
health_accept() {
	case "${HEALTH_STATE}" in
		healthy)
			recovery_clear_failures
			log_message "interface ${INTERFACE} healthy: ${HEALTH_DETAIL}"
			recover_interface6 || true
			return 0
			;;
		transient)
			recovery_clear_failures
			health_note_transient
			recover_interface6 || true
			return 0
			;;
	esac
	return 1
}

# Cheap re-check for the wait loop: addresses, carrier and the module dial
# state, with no ICMP and no DNS.  A full evaluate_health() may sit in probes
# for tens of seconds, which used to exceed the caller's entire wait budget on
# the very first iteration - so the "wait for DHCP" path never really waited.
health_poll_once() {
	local addr4 addr6 dev
	addr4="$(iface_address "${INTERFACE}" 4 || true)"
	addr6="$(iface_address "${INTERFACE6}" 6 || true)"
	dev="$(iface_device "${INTERFACE}" || true)"
	HEALTH_ADDR4="${addr4:-none}"
	HEALTH_ADDR6="${addr6:-none}"
	HEALTH_DEVICE="${dev:-none}"
	HEALTH_CARRIER=0
	if iface_carrier "${dev}"; then
		HEALTH_CARRIER=1
	fi
	if [ -n "${addr4}" ] || [ -n "${addr6}" ]; then
		HEALTH_STATE='healthy'
		HEALTH_DETAIL="iface=${INTERFACE} device=${HEALTH_DEVICE} ipv4=${HEALTH_ADDR4} ipv6=${HEALTH_ADDR6} carrier=${HEALTH_CARRIER}"
		return 0
	fi
	HEALTH_DETAIL="iface=${INTERFACE} device=${HEALTH_DEVICE} ipv4=none ipv6=none carrier=${HEALTH_CARRIER}"
	if [ "${HEALTH_CARRIER}" = '1' ] && modem_dial_status; then
		HEALTH_STATE='transient'
		HEALTH_DETAIL="${HEALTH_DETAIL} dial=${DIAL_DETAIL}"
		return 0
	fi
	HEALTH_STATE='unhealthy'
	HEALTH_DETAIL="${HEALTH_DETAIL} dial=${DIAL_DETAIL}"
	return 1
}

# Poll until the data path is usable, the wait budget is spent, or the round
# deadline passes.  One full evaluation runs first (the only one allowed to
# probe); every later iteration uses the cheap poll so the caller's wait
# window is actually spent waiting rather than probing.
wait_for_health() {
	local limit="$1" started remaining waited
	started="$(date +%s)"
	evaluate_health
	health_accept && return 0
	while :; do
		remaining=$((ROUND_DEADLINE - $(date +%s)))
		[ "${remaining}" -le 0 ] && return 1
		[ "${remaining}" -lt "${limit}" ] && limit="${remaining}"
		# Wall clock, not sleep count: the round budget must be honoured
		# either way.
		waited=$(($(date +%s) - started))
		[ "${waited}" -ge "${limit}" ] && return 1
		sleep 2
		health_poll_once
		health_accept && return 0
	done
}

# Bring the interface up and nurse it until the data path is really usable.
# Covers the real-world "modem online, interface config present, but no IP"
# case: wait for DHCP (with an explicit address check, not just the up state),
# rebuild the module link when carrier is missing, and hard-recycle via
# ifdown/ifup when the DHCP client is stuck.  Every step is bounded by the
# per-round time budget and by the retry ceiling above.
bring_up_with_recovery() {
	local netdev="$1" failures remaining

	if ! recovery_gate; then
		log_message "recovery skipped: ${RECOVERY_REASON}"
		return 1
	fi
	failures="$(recovery_failures)"
	ROUND_DEADLINE=$(($(date +%s) + HEALTH_ROUND_TIMEOUT))
	evaluate_health
	log_recovery 'start' "round=$((failures + 1))/${HEALTH_MAX_RETRIES} budget=${HEALTH_ROUND_TIMEOUT}s action=bring-up"

	bring_up
	if wait_for_health 20; then
		return 0
	fi

	# Carrier missing: the module-side data link is down, not the DHCP client.
	remaining=$((ROUND_DEADLINE - $(date +%s)))
	if [ "${HEALTH_CARRIER}" != '1' ] && [ "${remaining}" -gt 20 ]; then
		log_recovery 'carrier-missing' 'action=rebuild-modem-link'
		# Not wrapped in run_with_timeout: `timeout` cannot run a shell
		# function.  modem_cycle_link bounds its own AT calls, and the round
		# deadline below bounds the rest.
		modem_cycle_link "${netdev}" || true
		bring_up
		if wait_for_health 16; then
			return 0
		fi
	fi

	# Carrier present but still no address: the DHCP client is stuck.
	# Force a fresh ifdown/ifup before touching the modem link.
	remaining=$((ROUND_DEADLINE - $(date +%s)))
	if [ "${remaining}" -gt 20 ]; then
		log_recovery 'no-address' 'action=ifdown-ifup-recycle'
		run_with_timeout 30 ifdown "${INTERFACE}" >/dev/null 2>&1 || true
		sleep 2
		bring_up
		if wait_for_health 16; then
			return 0
		fi
	fi

	# Last resort: rebuild the module-side data link.
	remaining=$((ROUND_DEADLINE - $(date +%s)))
	if [ -n "${netdev}" ] && [ "${remaining}" -gt 20 ]; then
		log_recovery 'still-no-address' 'action=rebuild-modem-link(last-resort)'
		modem_cycle_link "${netdev}" || true
		bring_up
		if wait_for_health 16; then
			return 0
		fi
	fi

	remaining=$((ROUND_DEADLINE - $(date +%s)))
	[ "${remaining}" -gt 0 ] || log_recovery 'round-timeout' "budget=${HEALTH_ROUND_TIMEOUT}s exhausted action=record-failure"
	recovery_record_failure
	if [ -f "${HALT_FILE}" ]; then
		log_recovery 'halted' 'action=wait-for-manual-intervention'
	else
		log_recovery 'failed' "backoff-until-$(state_read "${NEXT_ATTEMPT_FILE}" 0)"
	fi
	return 1
}

sync_manager() {
	local info state netdev
	info="$(mt5700m_usb_info || true)"
	state="${info%%|*}"
	if [ "${state}" != 'normal' ]; then
		bring_down
		[ -n "${info}" ] && log_message "module unavailable state=${state}" || true
		return 0
	fi
	# USB mode guard: wrong SETMODE leaves the NCM data interface absent even
	# though the modem is online; ensure mode 4 before binding/awaiting it.
	[ "$(config_value enabled 1)" = '1' ] && modem_ensure_usb_mode || true
	mt5700m_bind_network_driver || log_message 'unable to bind MT5700M NCM interface'
	mt5700m_pcui_port >/dev/null 2>&1 || {
		mt5700m_bind_serial_driver || true
		sleep 1
	}
	netdev="$(mt5700m_wait_netdev 5 || true)"
	if [ -z "${netdev}" ]; then
		log_message 'NCM interface missing, forcing rebind'
		mt5700m_force_ncm_rebind || true
		sleep 2
		netdev="$(mt5700m_wait_netdev 8 || true)"
	fi
	[ -n "${netdev}" ] || {
		log_message 'normal-mode module has no network interface'
		return 1
	}
	ensure_network "${netdev}"
	if [ "$(config_value enabled 1)" = '1' ]; then
		load_health_config
		if evaluate_health; then
			# healthy or a short-lived state anomaly: leave the link alone.
			case "${HEALTH_STATE}" in
				transient) health_note_transient ;;
			esac
			recovery_clear_failures
			recover_interface6 || true
		elif modem_connected; then
			log_message "modem online but interface not healthy: ${HEALTH_DETAIL}"
			bring_up_with_recovery "${netdev}" || true
		else
			bring_up
		fi
	else
		bring_down
	fi
	# 2 tells the monitor that recovery is halted: no aggressive polling.
	[ -f "${HALT_FILE}" ] && return 2
	return 0
}

apply_profile() {
	local pdp protocol apn username password auth auth_code dial_mode
	pdp="$(config_value pdp_type ipv4v6)"
	case "${pdp}" in ip) protocol='IP' ;; ipv6) protocol='IPV6' ;; *) protocol='IPV4V6' ;; esac
	# USB host dialing is the default (dial_mode=1): the NCM port carries the
	# data session and OpenWrt runs DHCP on it.  dial_mode=0 is module-embedded
	# (RNDIS-like, no host DHCP), 2 is reserved.
	dial_mode="$(config_value dial_mode 1)"
	case "${dial_mode}" in 0|1|2) ;; *) dial_mode=1 ;; esac
	apn="$(config_value apn '')"
	username="$(config_value username '')"
	password="$(config_value password '')"
	auth="$(config_value auth none)"
	case "${auth}" in pap) auth_code=1 ;; chap) auth_code=2 ;; *) auth_code=0 ;; esac
	"${AT_HELPER}" advanced-set autodial 1 "${dial_mode}" "${protocol}" "${apn}" "${username}" "${password}" "${auth_code}" >/dev/null
}

connect_manager() {
	local netdev rc
	CONFIG_CHANGED=0
	set_if_changed mt5700m.connection.enabled 1
	[ "${CONFIG_CHANGED}" = '0' ] || uci -q commit mt5700m
	# Manual action counts as the intervention the halted state waits for.
	load_health_config
	recovery_reset
	sync_manager
	rc=$?
	[ "${rc}" = '0' ] || [ "${rc}" = '2' ] || return 1
	apply_profile || log_message 'module profile was not changed; continuing with retained profile'
	netdev="$(mt5700m_netdev || true)"
	if [ -n "${netdev}" ]; then
		bring_up_with_recovery "${netdev}" || true
	else
		bring_up
	fi
	log_message 'connection enabled'
}

disconnect_manager() {
	CONFIG_CHANGED=0
	set_if_changed mt5700m.connection.enabled 0
	[ "${CONFIG_CHANGED}" = '0' ] || uci -q commit mt5700m
	bring_down
	log_message 'connection disabled'
}

redial_manager() {
	local netdev rc
	bring_down
	sleep 1
	CONFIG_CHANGED=0
	set_if_changed mt5700m.connection.enabled 1
	[ "${CONFIG_CHANGED}" = '0' ] || uci -q commit mt5700m
	# Manual redial clears the retry counter, backoff and halted state.
	load_health_config
	recovery_reset
	sync_manager
	rc=$?
	[ "${rc}" = '0' ] || [ "${rc}" = '2' ] || return 1
	apply_profile || log_message 'module profile was not changed during redial'
	netdev="$(mt5700m_netdev || true)"
	if [ -n "${netdev}" ]; then
		bring_up_with_recovery "${netdev}" || true
	else
		bring_up
	fi
	log_message 'connection recycled'
}

status_json() {
	local info state rest product slot netdev atport status4 status6 up4 up6 carrier
	load_health_config
	. /usr/share/libubox/jshn.sh
	info="$(mt5700m_usb_info || true)"
	state="${info%%|*}"
	[ -n "${info}" ] || state='absent'
	rest="${info#*|}"; product="${rest%%|*}"; slot="${rest#*|}"
	netdev="$(mt5700m_netdev || true)"
	atport="$(mt5700m_pcui_port || true)"
	status4="$(ubus call "network.interface.${INTERFACE}" status 2>/dev/null || true)"
	status6="$(ubus call "network.interface.${INTERFACE6}" status 2>/dev/null || true)"
	up4="$(bool_value "$(printf '%s' "${status4}" | jsonfilter -e '@.up' 2>/dev/null)")"
	up6="$(bool_value "$(printf '%s' "${status6}" | jsonfilter -e '@.up' 2>/dev/null)")"
	carrier=0
	iface_carrier "${netdev}" && carrier=1
	json_init
	json_add_boolean running "$([ "$(config_value enabled 1)" = '1' ] && [ "${state}" = 'normal' ] && echo 1 || echo 0)"
	json_add_boolean connected "$({ [ "${up4}" = '1' ] || [ "${up6}" = '1' ]; } && [ "${carrier}" = '1' ] && echo 1 || echo 0)"
	json_add_boolean ipv4_up "${up4}"
	json_add_boolean ipv6_up "${up6}"
	json_add_boolean carrier "${carrier}"
	json_add_string usb_state "${state}"
	json_add_string usb_pid "${product}"
	json_add_string usb_slot "${slot}"
	json_add_string usb_mode "$(modem_usb_mode || echo '')"
	json_add_string at_port "${atport}"
	json_add_string network "${netdev}"
	json_add_string interface "${INTERFACE}"
	json_add_string interface6 "${INTERFACE6}"
	json_add_string mode 'NCM / ECM'
	json_add_string metric "$(uci -q get network.${INTERFACE}.metric 2>/dev/null || config_value metric 50)"
	json_add_string health "$(health_state_quick)"
	json_add_string ipv4_address "$(iface_address "${INTERFACE}" 4 || echo '')"
	json_add_string ipv6_address "$(iface_address "${INTERFACE6}" 6 || echo '')"
	json_add_string recovery "$(recovery_failures)/${HEALTH_MAX_RETRIES}"
	json_add_boolean recovery_halted "$([ -f "${HALT_FILE}" ] && echo 1 || echo 0)"
	json_dump
}

monitor_manager() {
	local interval=15 rc
	while :; do
		interval=15
		if acquire_lock; then
			sync_manager >/dev/null 2>&1
			rc=$?
			case "${rc}" in
				0) interval=15 ;;
				# Recovery is halted and waiting for manual intervention:
				# no point in polling aggressively.
				2) interval=60 ;;
				# Backoff / unresolved fault: do not hammer the module.
				*) interval=30 ;;
			esac
			# Temperature shares the AT channel with sync_manager; keep it
			# inside the lock so the two never talk to the module at once.
			# A concurrent reader corrupts both responses.
			refresh_temperature_cache >/dev/null 2>&1 || true
			release_lock
		fi
		sleep "${interval}"
	done
}

action="${1:-status-json}"
case "${action}" in
	monitor) monitor_manager ;;
	status|status-json) status_json ;;
	refresh-temperature) refresh_temperature_cache ;;
	log) tail -n 120 "${LOG_FILE}" 2>/dev/null || true ;;
	reset-recovery)
		load_health_config
		recovery_reset
		echo "recovery state cleared (retry counter, backoff and halted flag)"
		;;
	*)
		acquire_lock_wait || { echo 'manager is busy' >&2; exit 2; }
		trap release_lock EXIT INT TERM
		case "${action}" in
			sync) sync_manager ;;
			connect) connect_manager ;;
			disconnect) disconnect_manager ;;
			redial) redial_manager ;;
			down) bring_down ;;
			*) echo "Usage: $0 {status-json|sync|connect|disconnect|redial|reset-recovery|refresh-temperature|log|monitor}" >&2; exit 64 ;;
		esac
		;;
esac

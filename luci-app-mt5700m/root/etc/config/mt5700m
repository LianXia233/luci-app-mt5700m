config mt5700m 'settings'
	option enabled '1'
	option mode 'auto'
	option at_port ''
	option host '192.168.8.1'
	option port '20249'
	option timeout '8'

# Dial health check / recovery policy.  Values below are the built-in
# defaults; the section only exists so they can be tuned without rebuilding.
config recovery 'recovery'
	option max_retries '3'
	option backoff_base '60'
	option backoff_max '900'
	option round_timeout '90'
	option probe_timeout '5'
	option ping_host '223.5.5.5'
	option ping_host6 '2400:3200::1'
	option dns_host 'www.baidu.com'
	option v6_cooldown '300'
	option halt_notify '600'
	option radio_settle '45'

config connection 'connection'
	option enabled '1'
	option dial_mode '1'
	option apn ''
	option pdp_type 'ipv4v6'
	option auth 'none'
	option username ''
	option password ''
	option metric '50'

# DNS injected into the two interfaces this package owns.  The manager and
# /usr/share/mt5700m/dns.sh read these values on every start/up; they are
# never written to the global resolver or to another interface.
config dns 'dns'
	option ipv4_enabled '1'
	option ipv4_primary '119.29.29.29'
	option ipv4_secondary '223.5.5.5'
	option ipv6_enabled '1'
	option ipv6_primary '2402:4e00::'
	option ipv6_secondary '2400:3200::1'

# NTP is delegated to the system daemon (sysntpd or chrony); the plugin only
# writes this ordered server list and reads the daemon's status back.  An
# empty list is valid only while NTP management is disabled.
config ntp 'ntp'
	option enabled '1'
	list server 'ntp.tencent.com'
	list server 'time.cloudflare.com'
	list server 'ntp.aliyun.com'

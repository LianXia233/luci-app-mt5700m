#!/bin/sh
# USB hotplug: discovery and driver binding live in the Rust backend now.
# This script only decides *when* to call it, and keeps the log lines the
# field notes refer to.

PROG=/usr/bin/at-webserver
[ -x "$PROG" ] || exit 0

case "${ACTION:-}" in
	add)
		case "${PRODUCT:-}" in 3466/3301/*|3466/3301) ;; *) exit 0 ;; esac
		if "$PROG" usb bind-network >/dev/null 2>&1; then
			logger -t mt5700m-hotplug 'registered MT5700M NCM network interface'
		else
			logger -t mt5700m-hotplug 'unable to register MT5700M NCM network interface'
		fi
		if "$PROG" usb bind-serial >/dev/null 2>&1; then
			logger -t mt5700m-hotplug 'registered MT5700M normal-mode serial interfaces'
		else
			logger -t mt5700m-hotplug 'unable to register MT5700M option serial interfaces'
		fi
		;;
	remove)
		# A removal event may no longer expose PRODUCT. Only sync when the
		# documented module is really gone; unplugging a U disk must not touch
		# the AT side.
		if "$PROG" usb info >/dev/null 2>&1; then
			exit 0
		fi
		;;
	*) exit 0 ;;
esac

( sleep 1; "$PROG" manager sync >/dev/null 2>&1 ) &
